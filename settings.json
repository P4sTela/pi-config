{
  "lastChangelogVersion": "0.84.3",
  "theme": "dark",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "deepseek-v4-pro",
    "deepseek-v4-flash",
    "kimi-k2.7-code",
    "glm-5.2",
    "qwen3.7-max",
    "rglm/glm-5.2",
    "rglm/glm-4.5-flash",
    "gpt-5.6-*"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-terra",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-terra",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-terra",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "fallbackModels": [
          "opencode-go/kimi-k2.7-code"
        ]
      }
    }
  },
  "shellCommandPrefix": "export PATH=\"$HOME/.pi/agent/npm/node_modules/.bin:$PATH\"",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:pi-subagents",
    "npm:pine-of-glass",
    "npm:context-mode",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-kanban",
    "npm:checkpoint-pi",
    "npm:pi-plan",
    "npm:pi-review",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@ff-labs/pi-fff"
  ]
}